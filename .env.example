# =========================================================
# LLM Provider (OpenAI)
# =========================================================
OPENAI_API_KEY=sk-your-openai-key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# =========================================================
# Embeddings
# =========================================================
# Options: "openai" | "sentence-transformers"
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# =========================================================
# Vector Store (ChromaDB)
# =========================================================
VECTORSTORE_PROVIDER=chroma
CHROMA_PERSIST_DIR=./.chroma
CHROMA_COLLECTION=rag_documents

# =========================================================
# RAG Configuration
# =========================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
SCORE_THRESHOLD=0.0

# =========================================================
# MCP — external tools (Tavily web search via Model Context Protocol)
# =========================================================
# Opt-in. When enabled AND TAVILY_API_KEY is set, the agent gains live
# web-search tools alongside retrieve_context. Get a key at https://tavily.com
MCP_ENABLED=false
TAVILY_API_KEY=tvly-your-tavily-key
# Transport for the Tavily MCP server:
#   "http"  -> hosted streamable-HTTP endpoint (no Node needed; default)
#   "stdio" -> local `npx tavily-mcp` process (requires Node/npx installed)
MCP_TAVILY_TRANSPORT=http

# =========================================================
# LangSmith (Observability)
# =========================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls-your-langsmith-key
LANGCHAIN_PROJECT=reto3-react-rag

# =========================================================
# API
# =========================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
LOG_LEVEL=INFO
ENVIRONMENT=development
